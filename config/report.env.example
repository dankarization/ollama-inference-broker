# Copy to ~/.config/ollama-inference-broker/report.env and chmod 600.
# Requires channels.telegram.accounts.default.botToken (or token) in
# ~/.openclaw/openclaw.json by default.
BROKER_REPORT_TELEGRAM_TARGET=REPLACE_WITH_CHAT_ID
BROKER_REPORT_TELEGRAM_THREAD_ID=REPLACE_WITH_THREAD_ID
# BROKER_REPORT_TELEGRAM_ACCOUNT=default
# OPENCLAW_CONFIG_PATH=/absolute/path/to/openclaw.json
# BROKER_OLLAMA_URL=http://executor-host:11434
# BROKER_SOURCES_POLICY=/absolute/path/to/sources.json
