[Unit]
Description=Local Ollama inference broker (configure before dispatch)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/ollama-inference-broker
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BROKER_BIND=127.0.0.1
Environment=BROKER_PORT=8088
Environment=BROKER_DB=%h/.local/state/ollama-inference-broker/broker.sqlite3
Environment=OLLAMA_TIMEOUT_SECONDS=300
Environment=BROKER_DISPATCH_ENABLED=false
Environment=BROKER_WAL_AUTOCHECKPOINT_PAGES=4096
Environment=BROKER_JOURNAL_SIZE_LIMIT_BYTES=67108864
Environment=BROKER_WAL_BUDGET_BYTES=134217728
Environment=BROKER_WAL_CHECKPOINT_INTERVAL_SECONDS=60
Environment=BROKER_MIN_FREE_SPACE_BYTES=2147483648
EnvironmentFile=%h/.config/ollama-inference-broker/broker.env
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/ollama-inference-broker
ExecStart=/usr/bin/python3 -m broker
# The supported drain operation is `systemctl --user reload …`: signal only
# the broker MainPID, never the cgroup that also contains an active curl call.
ExecReload=/usr/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
