[Unit]
Description=Local Ollama inference broker (source-scoped pilot dispatch)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/.openclaw/workspace/.deploy/ollama-inference-broker-current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MAINPC_MAC=2c:f0:5d:74:6a:44
Environment=BROKER_BIND=127.0.0.1
Environment=BROKER_PORT=8088
Environment=BROKER_DB=%h/.local/state/ollama-inference-broker/broker.sqlite3
Environment=OLLAMA_TIMEOUT_SECONDS=300
Environment=BROKER_DISPATCH_ENABLED=true
Environment=BROKER_SOURCES_POLICY=%h/.local/state/ollama-inference-broker/sources.json
# Legacy allowlist is intentionally retained for policy-less rollback only.
# With the policy above, dispatcher sources/weights are loaded at runtime.
Environment=BROKER_DISPATCH_SOURCES=pilot-mainpc
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/ollama-inference-broker
ExecStart=/usr/bin/python3 -m broker
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
